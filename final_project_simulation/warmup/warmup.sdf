<plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/><model name="ground_plane"><static>true</static><link name="link"><collision name="floor"><geometry><plane><normal>0 0 1</normal><size>12 10</size></plane></geometry></collision><visual name="floor"><geometry><plane><normal>0 0 1</normal><size>12 10</size></plane></geometry><material><ambient>.87 .87 .85 1</ambient><diffuse>.87 .87 .85 1</diffuse></material></visual></link></model><light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>1 1 1 1</diffuse><specular>.2 .2 .2 1</specular><direction>-.2 -.3 -1</direction><cast_shadows>false</cast_shadows></light><model name="north_wall"><static>true</static><pose>0 4 0.225 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>10 0.16 0.45</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 0.16 0.45</size></box></geometry><material><ambient>.45 .55 .65 1</ambient><diffuse>.45 .55 .65 1</diffuse></material></visual></link></model><model name="south_wall"><static>true</static><pose>0 -4 0.225 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>10 0.16 0.45</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 0.16 0.45</size></box></geometry><material><ambient>.45 .55 .65 1</ambient><diffuse>.45 .55 .65 1</diffuse></material></visual></link></model><model name="west_wall"><static>true</static><pose>-5 0 0.225 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.16 8 0.45</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.16 8 0.45</size></box></geometry><material><ambient>.45 .55 .65 1</ambient><diffuse>.45 .55 .65 1</diffuse></material></visual></link></model><model name="east_wall"><static>true</static><pose>5 0 0.225 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.16 8 0.45</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.16 8 0.45</size></box></geometry><material><ambient>.45 .55 .65 1</ambient><diffuse>.45 .55 .65 1</diffuse></material></visual></link></model><model name="center_block"><static>true</static><pose>0 0 0.175 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.6 1.0 0.35</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.6 1.0 0.35</size></box></geometry><material><ambient>.30 .65 .85 1</ambient><diffuse>.30 .65 .85 1</diffuse></material></visual></link></model><model name="upper_block"><static>true</static><pose>-2 1.8 0.175 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.8 0.8 0.35</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8 0.8 0.35</size></box></geometry><material><ambient>.85 .55 .25 1</ambient><diffuse>.85 .55 .25 1</diffuse></material></visual></link></model><model name="lower_block"><static>true</static><pose>2 -1 0.175 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.8 0.8 0.35</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8 0.8 0.35</size></box></geometry><material><ambient>.45 .75 .40 1</ambient><diffuse>.45 .75 .40 1</diffuse></material></visual></link></model></world></sdf>
